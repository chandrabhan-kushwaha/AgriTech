# Production Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas or Self-Hosted Connection URI
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/agritech?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/agritech

# Secret key for signing JWT tokens (use a long random alphanumeric string)
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production

# Optional: Comma-separated list of allowed CORS origins (leave * for all)
ALLOWED_ORIGINS=*
